            "DAYS_SINCE_INSTALL": [
              ">=",
              3
            ]
          },
          "AND",
          {
            "HAS_PURCHASED_IAP": [
              false
            ]
          },
          "AND",
          {
            "STATISTICS_COMPARISON": [
              "GAMES_PLAYED_TODAY",
              ">=",
              3
            ]
          }
        ],
